  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00031" ixy="0" ixz="0" iyy="0.00031" iyz="0" izz="0.000375"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.43 0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="4.16667e-06" ixy="0" ixz="0" iyy="4.16667e-06" iyz="0" izz="7.5e-06"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_middle_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_middle_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>0.80</wheel_separation>
      <wheel_radius>0.14</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_rocker_joint</joint_name>
      <p_gain>40</p_gain>
      <i_gain>0</i_gain>
      <d_gain>6</d_gain>
      <cmd_max>150</cmd_max>
      <cmd_min>-150</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_rocker_joint</joint_name>
      <p_gain>40</p_gain>
      <i_gain>0</i_gain>
      <d_gain>6</d_gain>
      <cmd_max>150</cmd_max>
      <cmd_min>-150</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_bogie_joint</joint_name>
      <p_gain>12</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
      <cmd_max>150</cmd_max>
      <cmd_min>-150</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_bogie_joint</joint_name>
      <p_gain>12</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
      <cmd_max>150</cmd_max>
      <cmd_min>-150</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor type="gpu_lidar" name="lidar">
      <topic>scan</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.25</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu">
      <topic>imu/data</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <enable_orientation>true</enable_orientation>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera">
      <topic>camera/image_raw</topic>
      <ignition_frame_id>camera_link</ignition_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>

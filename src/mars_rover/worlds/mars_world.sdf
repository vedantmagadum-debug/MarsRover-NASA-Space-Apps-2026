<visual name="hill_0"><pose>150 60 -21.82 0 0 0</pose><geometry><sphere><radius>43.8</radius></sphere></geometry><material><ambient>0.46 0.36 0.24 1</ambient><diffuse>0.58 0.45 0.30 1</diffuse><specular>0.01 0.01 0.01 1</specular></material></visual>

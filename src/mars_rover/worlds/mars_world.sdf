<?xml version="1.0" ?>
<!-- Mars Jezero-crater style world (Perseverance imagery) - Gazebo Fortress / SDF 1.8
     Obstacles are named obstacle_* (static, with collision). -->
<sdf version="1.8">
  <world name="mars_world">
    <gravity>0 0 -3.721</gravity>
    <physics name="mars_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Fortress system plugins: without these nothing simulates, renders or publishes -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <scene>
      <ambient>0.55 0.45 0.34 1</ambient>
      <background>0.76 0.71 0.50 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.85 0.68 1</diffuse>
      <specular>0.25 0.22 0.18 1</specular>
      <attenuation><range>2000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <!-- Ground -->
    <model name="mars_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
<material><ambient>0.53 0.40 0.26 1</ambient><diffuse>0.66 0.50 0.32 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Horizon hills, mesas and crater rim -->
